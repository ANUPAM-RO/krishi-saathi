// Krishi Saathi data model. See docs/ARCHITECTURE.md for the entity overview.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  FARMER
  ADMIN
  EXPERT
}

enum Language {
  en
  hi
  bn
}

enum AreaUnit {
  BIGHA
  ACRE
  HECTARE
}

enum SoilType {
  ALLUVIAL
  CLAY
  LOAMY
  SANDY
  LATERITE
  RED
  BLACK
  OTHER
}

enum CropSeason {
  KHARIF
  RABI
  ZAID
  PERENNIAL
}

enum FarmerCropStatus {
  PLANNED
  ACTIVE
  HARVESTED
  FAILED
}

enum ActivityType {
  LAND_PREPARATION
  SOWING
  TRANSPLANTING
  IRRIGATION
  FERTILIZER
  WEEDING
  PEST_CONTROL
  HARVEST
  OTHER
}

enum ExpenseCategory {
  SEED
  FERTILIZER
  PESTICIDE
  LABOUR
  IRRIGATION
  MACHINERY
  TRANSPORT
  OTHER
}

enum NotificationType {
  CROP_REMINDER
  WEATHER_ALERT
  PRICE_ALERT
  ADVISORY
  GENERAL
}

enum PriceUnit {
  QUINTAL
  KG
}

enum AlertSeverity {
  INFO
  WARNING
  SEVERE
}

// ---------- Identity & auth ----------

model User {
  id        String    @id @default(uuid())
  phone     String    @unique // E.164, e.g. +919876543210
  name      String?
  role      Role      @default(FARMER)
  language  Language  @default(bn)
  village   String?
  district  String?
  state     String?
  isActive  Boolean   @default(true)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  farms         Farm[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([district])
  @@map("users")
}

model OtpRequest {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_requests")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ---------- Farms & crops ----------

model Farm {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  name                String
  area                Decimal   @db.Decimal(10, 3)
  areaUnit            AreaUnit  @default(BIGHA) @map("area_unit")
  village             String?
  district            String?
  state               String?
  latitude            Float?
  longitude           Float?
  soilType            SoilType? @map("soil_type")
  irrigationAvailable Boolean   @default(false) @map("irrigation_available")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmerCrops    FarmerCrop[]
  weatherRecords WeatherRecord[]

  @@index([userId])
  @@map("farms")
}

/// Master crop catalogue, managed by admins.
model Crop {
  id                  String     @id @default(uuid())
  code                String     @unique // stable slug, e.g. "paddy-aman"
  name                String // English
  nameHi              String     @map("hindi_name")
  nameBn              String     @map("bengali_name")
  localName           String?    @map("local_name")
  season              CropSeason
  durationDays        Int        @map("duration_days")
  /// Typical yield in quintals per acre, used when a farmer has not entered their own estimate.
  defaultYieldPerAcre Decimal?   @map("default_yield_per_acre") @db.Decimal(8, 2)
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  calendarTemplates CropCalendarTemplate[]
  farmerCrops       FarmerCrop[]
  mandiPrices       MandiPrice[]
  advisories        CropAdvisory[]
  weatherAlerts     WeatherAlert[]

  @@map("crops")
}

/// One activity in a crop's standard calendar, relative to the sowing date.
model CropCalendarTemplate {
  id            String       @id @default(uuid())
  cropId        String       @map("crop_id")
  activityType  ActivityType @map("activity_type")
  dayOffset     Int          @map("day_offset")
  title         String
  titleHi       String       @map("title_hi")
  titleBn       String       @map("title_bn")
  description   String?
  descriptionHi String?      @map("description_hi")
  descriptionBn String?      @map("description_bn")
  sortOrder     Int          @default(0) @map("sort_order")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  crop       Crop           @relation(fields: [cropId], references: [id], onDelete: Cascade)
  activities CropActivity[]

  @@index([cropId])
  @@map("crop_calendar_templates")
}

/// A crop actually planted by a farmer on one of their farms.
model FarmerCrop {
  id                      String           @id @default(uuid())
  farmId                  String           @map("farm_id")
  cropId                  String           @map("crop_id")
  sowingDate              DateTime         @map("sowing_date") @db.Date
  expectedHarvestDate     DateTime         @map("expected_harvest_date") @db.Date
  area                    Decimal          @db.Decimal(10, 3)
  areaUnit                AreaUnit         @default(BIGHA) @map("area_unit")
  status                  FarmerCropStatus @default(ACTIVE)
  /// Farmer's own expected total yield in quintals (optional; falls back to crop default).
  expectedYield           Decimal?         @map("expected_yield") @db.Decimal(10, 2)
  /// Farmer's expected selling price per quintal (optional; falls back to latest mandi price).
  expectedPricePerQuintal Decimal?         @map("expected_price_per_quintal") @db.Decimal(10, 2)
  notes                   String?
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  farm       Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop       Crop           @relation(fields: [cropId], references: [id])
  activities CropActivity[]
  expenses   Expense[]

  @@index([farmId])
  @@index([cropId])
  @@map("farmer_crops")
}

model CropActivity {
  id             String       @id @default(uuid())
  farmerCropId   String       @map("farmer_crop_id")
  templateId     String?      @map("template_id")
  activityType   ActivityType @map("activity_type")
  title          String
  titleHi        String       @map("title_hi")
  titleBn        String       @map("title_bn")
  description    String?
  descriptionHi  String?      @map("description_hi")
  descriptionBn  String?      @map("description_bn")
  scheduledDate  DateTime     @map("scheduled_date") @db.Date
  completed      Boolean      @default(false)
  completedAt    DateTime?    @map("completed_at")
  reminderSentAt DateTime?    @map("reminder_sent_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  farmerCrop FarmerCrop            @relation(fields: [farmerCropId], references: [id], onDelete: Cascade)
  template   CropCalendarTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([farmerCropId, scheduledDate])
  @@index([scheduledDate, completed])
  @@map("crop_activities")
}

model Expense {
  id           String          @id @default(uuid())
  farmerCropId String          @map("farmer_crop_id")
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  expenseDate  DateTime        @map("expense_date") @db.Date
  description  String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  farmerCrop FarmerCrop @relation(fields: [farmerCropId], references: [id], onDelete: Cascade)

  @@index([farmerCropId])
  @@map("expenses")
}

// ---------- Markets ----------

model Mandi {
  id        String   @id @default(uuid())
  name      String
  district  String
  state     String
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices MandiPrice[]

  @@unique([name, district, state])
  @@index([state, district])
  @@map("mandis")
}

model MandiPrice {
  id        String    @id @default(uuid())
  mandiId   String    @map("mandi_id")
  cropId    String    @map("crop_id")
  /// Modal (most common) price.
  price     Decimal   @db.Decimal(10, 2)
  minPrice  Decimal?  @map("min_price") @db.Decimal(10, 2)
  maxPrice  Decimal?  @map("max_price") @db.Decimal(10, 2)
  unit      PriceUnit @default(QUINTAL)
  priceDate DateTime  @map("price_date") @db.Date
  /// Where the price came from, e.g. "agmarknet", "admin", "csv-import".
  source    String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  mandi Mandi @relation(fields: [mandiId], references: [id], onDelete: Cascade)
  crop  Crop  @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([mandiId, cropId, priceDate])
  @@index([cropId, priceDate])
  @@map("mandi_prices")
}

// ---------- Weather ----------

/// Cached weather snapshot for a location; doubles as "last known" data when the provider is down.
model WeatherRecord {
  id              String   @id @default(uuid())
  farmId          String?  @map("farm_id")
  /// Rounded "lat,lon" so nearby farms share a cache entry.
  locationKey     String   @map("location_key")
  temperature     Float?
  humidity        Float?
  rainProbability Float?   @map("rain_probability")
  rainfall        Float?
  windSpeed       Float?   @map("wind_speed")
  weatherDate     DateTime @map("weather_date")
  /// Daily forecast array from the provider (normalised).
  forecast        Json?
  source          String   @default("open-meteo")
  fetchedAt       DateTime @default(now()) @map("fetched_at")

  farm Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)

  @@index([locationKey, fetchedAt])
  @@map("weather_records")
}

model WeatherAlert {
  id          String        @id @default(uuid())
  state       String?
  district    String?
  cropId      String?       @map("crop_id")
  severity    AlertSeverity @default(WARNING)
  title       String
  message     String
  language    Language      @default(bn)
  validFrom   DateTime      @map("valid_from")
  validTo     DateTime      @map("valid_to")
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([state, district, validTo])
  @@map("weather_alerts")
}

// ---------- Content & notifications ----------

model CropAdvisory {
  id          String      @id @default(uuid())
  cropId      String?     @map("crop_id")
  title       String
  description String
  season      CropSeason?
  language    Language
  state       String?
  district    String?
  isPublished Boolean     @default(false) @map("is_published")
  publishedAt DateTime?   @map("published_at")
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  crop Crop? @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([cropId, language, isPublished])
  @@map("crop_advisories")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  message     String
  /// Deep-link payload, e.g. { "farmerCropId": "...", "activityId": "..." }.
  data        Json?
  scheduledAt DateTime         @default(now()) @map("scheduled_at")
  sentAt      DateTime?        @map("sent_at")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sentAt, scheduledAt])
  @@map("notifications")
}

/// Audit trail for admin changes to important master data.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String // e.g. "crop.update"
  entity    String
  entityId  String?  @map("entity_id")
  changes   Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
