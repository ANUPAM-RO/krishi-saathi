# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (admin web). Mobile apps are not affected by CORS.
CORS_ORIGINS=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://krishi:krishi@localhost:5433/krishi_saathi?schema=public

# --- Auth ---
# Use long random strings in staging/production: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-dev-only-jwt-secret
OTP_SECRET=change-me-dev-only-otp-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# When true, the OTP is returned in the send-otp response and logged instead of sent by SMS. NEVER enable in production.
OTP_DEV_MODE=true
# SMS provider: "console" (logs only) or "msg91".
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Phones (E.164) that are always given the ADMIN role on login.
ADMIN_PHONES=+919999999999

# --- Push notifications (Expo push service, delivered via FCM on Android) ---
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# --- Weather (Open-Meteo, no key required) ---
WEATHER_CACHE_MINUTES=60

# --- Jobs ---
# Set to false on extra API replicas so cron jobs only run once.
JOBS_ENABLED=true
